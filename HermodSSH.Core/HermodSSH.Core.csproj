<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>org.GraphDefined.Vanaheimr.Hermod.SSH</RootNamespace>
    <AssemblyName>HermodSSH.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The wire format uses XML docs heavily; do not fail the build on missing ones yet. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- BouncyCastle (X25519/Ed25519/sntrup761/ChaCha20/…) and the Hermod DNS, TCP, PKI and logging
       infrastructure arrive transitively through the Vanaheimr submodules — no direct package needed. -->
  <ItemGroup>
    <ProjectReference Include="..\libs\Hermod\Hermod\Hermod.csproj" />
    <ProjectReference Include="..\libs\Styx\Styx\Styx.csproj" />
  </ItemGroup>

</Project>
